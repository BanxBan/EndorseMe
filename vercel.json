{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend/src/server.ts"
    },
    {
      "source": "/auth/(.*)",
      "destination": "backend/src/server.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
